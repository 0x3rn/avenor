// Canonical Prisma schema representation of Avenor's PostgreSQL data model (THE-115)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                   @id
  email                 String                   @unique
  name                  String
  emailVerified         Boolean                  @default(false) @map("email_verified")
  image                 String?
  activeWorkspaceId     String?                  @map("active_workspace_id")
  onboardingCompletedAt DateTime?                @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  accounts              Account[]
  sessions              Session[]
  orgMemberships        OrganizationMembership[]
  workspaceMemberships  WorkspaceMembership[]
  auditLogs             AuditLog[]

  @@map("users")
}

model Account {
  id           String   @id
  userId       String   @map("user_id")
  accountId    String   @map("account_id")
  providerId   String   @map("provider_id")
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId], map: "uq_accounts_provider_account")
  @@index([userId], map: "idx_accounts_user_id")
  @@map("accounts")
}

model Session {
  id                   String    @id
  userId               String    @map("user_id")
  tokenHash            String    @unique @map("token_hash")
  activeOrganizationId String?   @map("active_organization_id")
  activeWorkspaceId    String?   @map("active_workspace_id")
  ipAddress            String?   @map("ip_address")
  userAgent            String?   @map("user_agent")
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_sessions_user_id")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model Verification {
  id         String    @id
  identifier String
  valueHash  String    @map("value_hash")
  purpose    String    @default("EMAIL_VERIFICATION")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([identifier], map: "idx_verifications_identifier")
  @@map("verifications")
}

model Organization {
  id              String                   @id
  name            String
  slug            String                   @unique
  createdByUserId String?                  @map("created_by_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  memberships     OrganizationMembership[]
  workspaces      Workspace[]
  auditLogs       AuditLog[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           String
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId], map: "uq_organization_memberships_org_user")
  @@index([userId], map: "idx_organization_memberships_user_id")
  @@map("organization_memberships")
}

model Workspace {
  id                  String                @id
  organizationId      String                @map("organization_id")
  name                String
  slug                String
  defaultTimezone     String                @default("UTC") @map("default_timezone")
  defaultCurrency     String                @default("USD") @map("default_currency")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships         WorkspaceMembership[]
  projects            LogicalProject[]
  providerConnections ProviderConnection[]
  connectedResources  ConnectedResource[]
  resourceMappings    ResourceMapping[]
  auditLogs           AuditLog[]

  @@unique([organizationId, slug], map: "uq_workspaces_org_slug")
  @@index([organizationId], map: "idx_workspaces_organization_id")
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String    @id
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId], map: "uq_workspace_memberships_workspace_user")
  @@index([userId], map: "idx_workspace_memberships_user_id")
  @@map("workspace_memberships")
}

model LogicalProject {
  id               String               @id
  workspaceId      String               @map("workspace_id")
  name             String
  slug             String
  description      String?
  primaryDomain    String?              @map("primary_domain")
  status           String               @default("ACTIVE")
  createdByUserId  String?              @map("created_by_user_id")
  archivedAt       DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environments     ProjectEnvironment[]
  resourceMappings ResourceMapping[]

  @@unique([workspaceId, slug], map: "uq_logical_projects_workspace_slug")
  @@index([workspaceId], map: "idx_logical_projects_workspace_id")
  @@index([workspaceId, status], map: "idx_logical_projects_status")
  @@map("logical_projects")
}

model ProjectEnvironment {
  id               String            @id
  projectId        String            @map("project_id")
  name             String
  slug             String
  environmentType  String            @map("environment_type")
  primaryDomain    String?           @map("primary_domain")
  isDefault        Boolean           @default(false) @map("is_default")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  project          LogicalProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resourceMappings ResourceMapping[]

  @@unique([projectId, slug], map: "uq_project_environments_project_slug")
  @@unique([projectId, environmentType], map: "uq_project_environments_project_type")
  @@index([projectId], map: "idx_project_environments_project_id")
  @@map("project_environments")
}

model ProviderConnection {
  id                             String                    @id
  workspaceId                    String                    @map("workspace_id")
  providerKey                    String                    @map("provider_key")
  displayName                    String                    @map("display_name")
  authMode                       String                    @default("oauth2") @map("auth_mode")
  externalAccountId              String?                   @map("external_account_id")
  externalAccountLabel           String?                   @map("external_account_label")
  status                         String                    @default("DISCONNECTED")
  requestedScopes                String[]                  @default([]) @map("requested_scopes")
  grantedScopes                  String[]                  @default([]) @map("granted_scopes")
  encryptedCredentialsCiphertext String?                   @map("encrypted_credentials_ciphertext")
  encryptionKeyVersion           Int                       @default(1) @map("encryption_key_version")
  lastErrorCode                  String?                   @map("last_error_code")
  lastErrorSummary               String?                   @map("last_error_summary")
  metadata                       Json                      @default("{}")
  lastVerifiedAt                 DateTime?                 @map("last_verified_at") @db.Timestamptz(6)
  lastSyncAt                     DateTime?                 @map("last_sync_at") @db.Timestamptz(6)
  disconnectedAt                 DateTime?                 @map("disconnected_at") @db.Timestamptz(6)
  createdByUserId                String?                   @map("created_by_user_id")
  createdAt                      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  workspace                      Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedResources             ConnectedResource[]
  credential                     ProviderCredential?
  oauthStates                    OAuthAuthorizationState[]

  @@index([workspaceId], map: "idx_provider_connections_workspace_id")
  @@map("provider_connections")
}

model ProviderCredential {
  id                   String             @id
  organizationId       String             @map("organization_id")
  workspaceId          String             @map("workspace_id")
  providerConnectionId String             @unique(map: "uq_provider_credentials_connection") @map("provider_connection_id")
  providerKey          String             @map("provider_key")
  credentialType       String             @map("credential_type")
  keyId                String             @map("key_id")
  encryptionVersion    Int                @default(1) @map("encryption_version")
  algorithm            String             @default("aes-256-gcm")
  nonceBase64          String             @map("nonce_base64")
  ciphertextBase64     String             @map("ciphertext_base64")
  authTagBase64        String             @map("auth_tag_base64")
  aadHash              String             @map("aad_hash")
  tokenExpiresAt       DateTime?          @map("token_expires_at") @db.Timestamptz(6)
  refreshTokenPresent  Boolean            @default(false) @map("refresh_token_present")
  status               String             @default("ACTIVE")
  rotatedAt            DateTime?          @map("rotated_at") @db.Timestamptz(6)
  revokedAt            DateTime?          @map("revoked_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  connection           ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId], map: "idx_provider_credentials_workspace_id")
  @@index([organizationId], map: "idx_provider_credentials_org_id")
  @@map("provider_credentials")
}

model OAuthAuthorizationState {
  id                     String              @id
  stateTokenHash         String              @unique(map: "uq_oauth_authorization_states_token_hash") @map("state_token_hash")
  organizationId         String              @map("organization_id")
  workspaceId            String              @map("workspace_id")
  userId                 String              @map("user_id")
  providerKey            String              @map("provider_key")
  operation              String
  targetConnectionId     String?             @map("target_connection_id")
  redirectUri            String              @map("redirect_uri")
  requestedScopes        String[]            @default([]) @map("requested_scopes")
  codeVerifierCiphertext String              @map("code_verifier_ciphertext")
  codeChallenge          String              @map("code_challenge")
  codeChallengeMethod    String              @default("S256") @map("code_challenge_method")
  expiresAt              DateTime            @map("expires_at") @db.Timestamptz(6)
  consumedAt             DateTime?           @map("consumed_at") @db.Timestamptz(6)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  targetConnection       ProviderConnection? @relation(fields: [targetConnectionId], references: [id], onDelete: Cascade)

  @@index([workspaceId], map: "idx_oauth_authorization_states_workspace_id")
  @@index([userId], map: "idx_oauth_authorization_states_user_id")
  @@map("oauth_authorization_states")
}

model ConnectedResource {
  id                   String             @id
  providerConnectionId String             @map("provider_connection_id")
  workspaceId          String             @map("workspace_id")
  externalResourceId   String             @map("external_resource_id")
  resourceType         String             @map("resource_type")
  displayName          String             @map("display_name")
  metadata             Json               @default("{}")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  providerConnection   ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)
  workspace            Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  resourceMappings     ResourceMapping[]

  @@unique([providerConnectionId, externalResourceId], map: "uq_connected_resources_conn_external")
  @@index([workspaceId], map: "idx_connected_resources_workspace_id")
  @@map("connected_resources")
}

model ResourceMapping {
  id                  String              @id
  workspaceId         String              @map("workspace_id")
  projectId           String              @map("project_id")
  environmentId       String?             @map("environment_id")
  connectedResourceId String              @map("connected_resource_id")
  mappingRole         String              @default("PRIMARY") @map("mapping_role")
  createdByUserId     String?             @map("created_by_user_id")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             LogicalProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment         ProjectEnvironment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  connectedResource   ConnectedResource   @relation(fields: [connectedResourceId], references: [id], onDelete: Cascade)

  @@unique([projectId, connectedResourceId], map: "uq_resource_mappings_project_resource")
  @@index([projectId], map: "idx_resource_mappings_project_id")
  @@index([environmentId], map: "idx_resource_mappings_environment_id")
  @@map("resource_mappings")
}

model AuditLog {
  id             String       @id
  organizationId String       @map("organization_id")
  workspaceId    String?      @map("workspace_id")
  actorUserId    String?      @map("actor_user_id")
  action         String
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  summary        String
  metadata       Json         @default("{}")
  ipAddress      String?      @map("ip_address")
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_audit_logs_organization_created")
  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_audit_logs_workspace_created")
  @@map("audit_logs")
}

model MetricDefinition {
  id                        String              @id
  canonicalKey              String              @unique(map: "uq_metric_definitions_canonical_key") @map("canonical_key")
  providerKey               String              @map("provider_key")
  providerMetricName        String              @map("provider_metric_name")
  displayName               String              @map("display_name")
  description               String
  category                  String
  unit                      String
  valueType                 String              @map("value_type")
  aggregationRule           String              @map("aggregation_rule")
  numeratorMetricKey        String?             @map("numerator_metric_key")
  denominatorMetricKey      String?             @map("denominator_metric_key")
  weightMetricKey           String?             @map("weight_metric_key")
  isAdditiveAcrossDates     Boolean             @default(false) @map("is_additive_across_dates")
  isAdditiveAcrossResources Boolean             @default(false) @map("is_additive_across_resources")
  supportedDimensions       String[]            @default([]) @map("supported_dimensions")
  supportedGranularities    String[]            @default([]) @map("supported_granularities")
  timezoneBehavior          String              @map("timezone_behavior")
  freshnessWindowMinutes    Int                 @default(60) @map("freshness_window_minutes")
  capabilityKey             String              @map("capability_key")
  schemaVersion             Int                 @default(1) @map("schema_version")
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  observations              MetricObservation[]

  @@unique([providerKey, providerMetricName, schemaVersion], map: "uq_metric_definitions_provider_metric_ver")
  @@index([providerKey], map: "idx_metric_definitions_provider_key")
  @@index([category], map: "idx_metric_definitions_category")
  @@map("metric_definitions")
}

model IngestionRun {
  id                     String                      @id
  organizationId         String                      @map("organization_id")
  workspaceId            String                      @map("workspace_id")
  projectId              String?                     @map("project_id")
  environmentId          String?                     @map("environment_id")
  providerConnectionId   String                      @map("provider_connection_id")
  connectedResourceId    String                      @map("connected_resource_id")
  providerKey            String                      @map("provider_key")
  externalResourceId     String                      @map("external_resource_id")
  runType                String                      @map("run_type")
  jobIdempotencyKey      String                      @map("job_idempotency_key")
  queryFingerprint       String                      @map("query_fingerprint")
  periodStartDate        String                      @map("period_start_date")
  periodEndDate          String                      @map("period_end_date")
  reportingTimezone      String                      @map("reporting_timezone")
  status                 String
  attemptNumber          Int                         @default(1) @map("attempt_number")
  maxAttempts            Int                         @default(3) @map("max_attempts")
  recordsProcessed       Int                         @default(0) @map("records_processed")
  recordsInserted        Int                         @default(0) @map("records_inserted")
  recordsUpdated         Int                         @default(0) @map("records_updated")
  recordsUnchanged       Int                         @default(0) @map("records_unchanged")
  lastSuccessfulInterval String?                     @map("last_successful_interval")
  retryEligible          Boolean                     @default(false) @map("retry_eligible")
  nextRetryAt            DateTime?                   @map("next_retry_at") @db.Timestamptz(6)
  errorCode              String?                     @map("error_code")
  errorCategory          String?                     @map("error_category")
  errorSummary           String?                     @map("error_summary")
  quotaSnapshot          Json                        @default("{}") @map("quota_snapshot")
  metadata               Json                        @default("{}")
  startedAt              DateTime                    @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt            DateTime?                   @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  observations           MetricObservation[]
  revisions              MetricObservationRevision[]

  @@unique([workspaceId, jobIdempotencyKey], map: "uq_ingestion_runs_idempotency")
  @@index([workspaceId, createdAt(sort: Desc)], map: "idx_ingestion_runs_workspace_created")
  @@index([projectId, status, createdAt(sort: Desc)], map: "idx_ingestion_runs_project_status")
  @@index([connectedResourceId, status, createdAt(sort: Desc)], map: "idx_ingestion_runs_resource_status")
  @@map("ingestion_runs")
}

model IngestionWatermark {
  id                     String    @id
  organizationId         String    @map("organization_id")
  workspaceId            String    @map("workspace_id")
  projectId              String?   @map("project_id")
  environmentId          String?   @map("environment_id")
  providerConnectionId   String    @map("provider_connection_id")
  connectedResourceId    String    @map("connected_resource_id")
  providerKey            String    @map("provider_key")
  externalResourceId     String    @map("external_resource_id")
  queryScopeKey          String    @map("query_scope_key")
  queryVersion           Int       @default(1) @map("query_version")
  reportingTimezone      String    @map("reporting_timezone")
  lastAttemptedStartDate String?   @map("last_attempted_start_date")
  lastAttemptedEndDate   String?   @map("last_attempted_end_date")
  lastCommittedStartDate String?   @map("last_committed_start_date")
  lastCommittedEndDate   String?   @map("last_committed_end_date")
  backfillEarliestDate   String?   @map("backfill_earliest_date")
  backfillTargetDate     String?   @map("backfill_target_date")
  backfillCompleted      Boolean   @default(false) @map("backfill_completed")
  sourceCompleteness     String    @default("COMPLETE") @map("source_completeness")
  syncState              String    @default("PENDING") @map("sync_state")
  consecutiveFailures    Int       @default(0) @map("consecutive_failures")
  failedIntervals        Json      @default("[]") @map("failed_intervals")
  activeRunId            String?   @map("active_run_id")
  leaseExpiresAt         DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  nextScheduledAt        DateTime? @map("next_scheduled_at") @db.Timestamptz(6)
  rateLimitResetAt       DateTime? @map("rate_limit_reset_at") @db.Timestamptz(6)
  lastAttemptedAt        DateTime? @map("last_attempted_at") @db.Timestamptz(6)
  lastSucceededAt        DateTime? @map("last_succeeded_at") @db.Timestamptz(6)
  lastErrorCode          String?   @map("last_error_code")
  lastErrorSummary       String?   @map("last_error_summary")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, connectedResourceId, queryScopeKey, queryVersion], map: "uq_ingestion_watermarks_scope")
  @@index([workspaceId, syncState], map: "idx_ingestion_watermarks_workspace_state")
  @@index([projectId], map: "idx_ingestion_watermarks_project_id")
  @@index([nextScheduledAt], map: "idx_ingestion_watermarks_next_scheduled")
  @@map("ingestion_watermarks")
}

model MetricObservation {
  id                      String                      @id
  organizationId          String                      @map("organization_id")
  workspaceId             String                      @map("workspace_id")
  projectId               String?                     @map("project_id")
  environmentId           String?                     @map("environment_id")
  providerConnectionId    String                      @map("provider_connection_id")
  connectedResourceId     String                      @map("connected_resource_id")
  providerKey             String                      @map("provider_key")
  externalResourceId      String                      @map("external_resource_id")
  canonicalMetricKey      String                      @map("canonical_metric_key")
  providerMetricName      String                      @map("provider_metric_name")
  metricDefinitionVersion Int                         @default(1) @map("metric_definition_version")
  granularity             String
  periodStartDate         String                      @map("period_start_date")
  periodEndDate           String                      @map("period_end_date")
  periodStartUtc          DateTime                    @map("period_start_utc") @db.Timestamptz(6)
  periodEndUtc            DateTime                    @map("period_end_utc") @db.Timestamptz(6)
  reportingTimezone       String                      @map("reporting_timezone")
  dimensionKeyHash        String                      @map("dimension_key_hash")
  dimensionCanonicalKey   String                      @map("dimension_canonical_key")
  dimensions              Json                        @default("{}")
  queryFingerprint        String                      @map("query_fingerprint")
  unit                    String
  currency                String?
  numericValue            Decimal?                    @map("numeric_value") @db.Decimal(20, 6)
  numeratorValue          Decimal?                    @map("numerator_value") @db.Decimal(20, 6)
  denominatorValue        Decimal?                    @map("denominator_value") @db.Decimal(20, 6)
  completenessState       String                      @default("COMPLETE") @map("completeness_state")
  dataQualityFlags        Json                        @default("{}") @map("data_quality_flags")
  sourceUpdatedAt         DateTime?                   @map("source_updated_at") @db.Timestamptz(6)
  collectedAt             DateTime                    @default(now()) @map("collected_at") @db.Timestamptz(6)
  ingestionRunId          String?                     @map("ingestion_run_id")
  revisionNumber          Int                         @default(1) @map("revision_number")
  previousNumericValue    Decimal?                    @map("previous_numeric_value") @db.Decimal(20, 6)
  revisionReason          String?                     @map("revision_reason")
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  definition              MetricDefinition            @relation(fields: [canonicalMetricKey], references: [canonicalKey])
  ingestionRun            IngestionRun?               @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
