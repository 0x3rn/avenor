# ============================================================
# AVENOR — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================
# Copy this file to .env.local (for local development) or .env
# Never commit real credentials or secrets to Git.

NODE_ENV="development"
APP_ENV="development"

# PostgreSQL connection strings (Neon or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/avenor_dev?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/avenor_dev?sslmode=require"

# Dedicated isolated test database connection string (used by pnpm test:integration and pnpm test:security)
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/avenor_test?sslmode=require"

# Authentication secret (minimum 32 characters; generate with `openssl rand -hex 32`)
BETTER_AUTH_SECRET="dev-only-secret-do-not-use-in-production-0123456789abcdef"
BETTER_AUTH_URL="http://localhost:3000"

# 256-bit (64 hex chars) master key for encrypting server-side provider tokens at rest
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Public client configuration
NEXT_PUBLIC_APP_NAME="Avenor"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
