{
  "name": "avenor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/prepare-cloudflare-assets.ts",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:providers": "vitest run --config vitest.config.ts tests/unit/providers.test.tsx",
    "test:vault": "vitest run --config vitest.config.ts tests/unit/vault.test.ts && vitest run --config vitest.integration.config.ts tests/integration/vault-persistence.test.ts",
    "test:oauth": "vitest run --config vitest.config.ts tests/unit/oauth.test.ts && vitest run --config vitest.integration.config.ts tests/integration/oauth-lifecycle.test.ts",
    "test:connections": "vitest run --config vitest.integration.config.ts tests/integration/connections-workflow.test.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:e2e": "playwright test",
    "db:validate": "tsx scripts/db-cli.ts validate",
    "db:migrate": "tsx scripts/db-cli.ts migrate",
    "db:status": "tsx scripts/db-cli.ts status",
    "db:seed": "tsx scripts/db-cli.ts seed"
  },
  "dependencies": {
    "@avenor/auth": "workspace:*",
    "@avenor/config": "workspace:*",
    "@avenor/database": "workspace:*",
    "@avenor/types": "workspace:*",
    "@avenor/ui": "workspace:*",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^1.0.0",
    "next": "16.4.0",
    "pg": "^8.14.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "vitest": "^3.0.0"
  }
}
